# Copy this file to .env.local (gitignored) and fill in real values for
# your machine. Vite only exposes variables prefixed VITE_ to the browser.

# internal-auth-server's own base URL + API prefix. Called directly (no
# BFF, no session cookie) by RegisterPage/ForgotPasswordPage/ResetPasswordPage
# - see src/features/auth/api.js. Must match whatever
# internal-auth-server's own server.port + servlet.context-path are set to.
VITE_AUTH_API_BASE_URL=http://localhost:5151/api/v1

# The BFF's own origin (server/.env's PORT, default 4000). Everything else
# in the app (login, clients, users, roles, groups, sessions, settings)
# goes through here - see src/shared/lib/bffClient.js.
VITE_BFF_BASE_URL=http://localhost:4000
